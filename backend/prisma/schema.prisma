// SelahTech Academy LMS - PostgreSQL schema (Prisma)
// Mirrors the architecture diagram: Users, Roles, Courses, Modules, Lessons,
// Enrollments, Payments, Progress, Certificates (+ Assessments).

generator prisma_client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource postgresql_database {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

// STANDARD = full course. SCHOLARSHIP = discounted price, only the modules the instructor included in the scholarship program.
enum EnrollmentType {
  STANDARD
  SCHOLARSHIP
}

enum ScholarshipApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id              String   @id @default(uuid())
  fullName        String
  emailAddress    String   @unique
  // Null for accounts created with "Continue with Google": they have no password until (if ever) one is set.
  hashedPassword  String?
  googleSubjectId String?  @unique
  phoneNumber     String?
  // Small square JPEG/PNG/WebP (resized in the browser to about 256 px) stored as a data URL, so students need no Cloudinary account.
  profilePictureDataUrl String?
  userRole        UserRole @default(STUDENT)
  isAccountActive Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  instructorCloudinaryAccount InstructorCloudinaryAccount?
  coursesOwnedAsInstructor    Course[]
  enrollments                 Enrollment[]
  payments                    Payment[]
  lessonProgressRecords       LessonProgress[]
  assessmentAttempts          AssessmentAttempt[]
  certificates                Certificate[]
  scholarshipApplications     ScholarshipApplication[]
  passwordResetTokens         PasswordResetToken[]
  courseReviews               CourseReview[]
  lessonQuestions             LessonQuestion[]
  lessonAnswers               LessonAnswer[]

  @@map("users")
}

// One Cloudinary account per instructor (the "Multi-Account" box in the diagram).
// The API secret is stored encrypted (AES-256-GCM), never in plain text.
model InstructorCloudinaryAccount {
  id                           String   @id @default(uuid())
  instructorUserId             String   @unique
  cloudinaryCloudName          String
  cloudinaryApiKey             String
  encryptedCloudinaryApiSecret String
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  instructorUser User @relation(fields: [instructorUserId], references: [id], onDelete: Cascade)

  @@map("instructor_cloudinary_accounts")
}

model Course {
  id                String   @id @default(uuid())
  instructorUserId  String
  title             String
  description       String
  priceInKobo       Int
  thumbnailImageUrl String?
  category          String   @default("General")
  isPublished       Boolean  @default(false)
  // When true, students can apply for the scholarship price (see SCHOLARSHIP_DISCOUNT_PERCENTAGE).
  isScholarshipAvailable Boolean @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  instructorUser User           @relation(fields: [instructorUserId], references: [id])
  courseModules  CourseModule[]
  enrollments    Enrollment[]
  payments       Payment[]
  certificates   Certificate[]
  scholarshipApplications ScholarshipApplication[]
  reviews        CourseReview[]

  @@index([instructorUserId])
  @@index([category])
  @@map("courses")
}

model CourseModule {
  id                  String   @id @default(uuid())
  courseId            String
  title               String
  sequenceOrderNumber Int
  // Instructors switch this off for modules that scholarship students must not receive.
  isIncludedInScholarship Boolean @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, sequenceOrderNumber])
  @@map("course_modules")
}

model Lesson {
  id                      String   @id @default(uuid())
  courseModuleId          String
  title                   String
  description             String?
  sequenceOrderNumber     Int
  cloudinaryVideoPublicId String?
  backupBunnyStreamVideoId String? // Optional Bunny Stream backup copy (see diagram)
  videoDurationInSeconds  Int?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  courseModule   CourseModule     @relation(fields: [courseModuleId], references: [id], onDelete: Cascade)
  assessment     Assessment?
  progressRecords LessonProgress[]
  resources      LessonResource[]
  questions      LessonQuestion[]

  @@index([courseModuleId, sequenceOrderNumber])
  @@map("lessons")
}

model Enrollment {
  id                String   @id @default(uuid())
  studentUserId     String
  courseId          String
  enrolledAt        DateTime @default(now())
  enrollmentType    EnrollmentType @default(STANDARD)
  // End of the paid access window (3 months by default).
  accessExpiresAt   DateTime
  // End of the grace period after expiry (+1 month by default).
  gracePeriodEndsAt DateTime
  // Set by the background worker when a reminder e-mail has been sent; cleared again when the student renews.
  expiryReminderSentAt DateTime?
  graceReminderSentAt  DateTime?

  studentUser User   @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentUserId, courseId])
  @@map("enrollments")
}

enum PaymentKind {
  ENROLLMENT // first purchase of a course (also the upgrade from scholarship to the full course)
  RENEWAL    // a student who already has the course pays to extend access; price depends on how much is covered
  RETAKE     // a student who covered 100% restarts the course
}

// Small on/off switches the admin controls from the dashboard. A missing row means the default value.
model PlatformSetting {
  settingName  String   @id
  isEnabled    Boolean
  updatedAt    DateTime @updatedAt

  @@map("platform_settings")
}

model Payment {
  id                  String        @id @default(uuid())
  studentUserId       String
  courseId            String
  paystackReference   String        @unique
  amountInKobo        Int
  isScholarshipPayment Boolean      @default(false)
  paymentKind         PaymentKind   @default(ENROLLMENT)
  paymentStatus       PaymentStatus @default(PENDING)
  paystackAuthorizationUrl String?
  paidAt              DateTime?
  createdAt           DateTime      @default(now())

  studentUser User   @relation(fields: [studentUserId], references: [id])
  course      Course @relation(fields: [courseId], references: [id])

  @@index([studentUserId])
  @@index([courseId])
  @@map("payments")
}

model LessonProgress {
  id                           String    @id @default(uuid())
  studentUserId                String
  lessonId                     String
  isCompleted                  Boolean   @default(false)
  lastWatchedPositionInSeconds Int       @default(0)
  completedAt                  DateTime?
  updatedAt                    DateTime  @updatedAt

  studentUser User   @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  lesson      Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentUserId, lessonId])
  @@map("lesson_progress")
}

model Assessment {
  id                  String   @id @default(uuid())
  lessonId            String   @unique
  title               String
  passMarkPercentage  Int      @default(70)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  lesson   Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions AssessmentQuestion[]
  attempts AssessmentAttempt[]

  @@map("assessments")
}

model AssessmentQuestion {
  id                  String @id @default(uuid())
  assessmentId        String
  questionText        String
  sequenceOrderNumber Int

  assessment    Assessment               @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answerOptions AssessmentAnswerOption[]

  @@index([assessmentId, sequenceOrderNumber])
  @@map("assessment_questions")
}

model AssessmentAnswerOption {
  id                   String  @id @default(uuid())
  assessmentQuestionId String
  optionText           String
  isCorrectOption      Boolean @default(false)

  assessmentQuestion AssessmentQuestion @relation(fields: [assessmentQuestionId], references: [id], onDelete: Cascade)

  @@map("assessment_answer_options")
}

model AssessmentAttempt {
  id              String   @id @default(uuid())
  assessmentId    String
  studentUserId   String
  scorePercentage Int
  hasPassed       Boolean
  submittedAt     DateTime @default(now())

  assessment  Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentUser User       @relation(fields: [studentUserId], references: [id], onDelete: Cascade)

  @@index([studentUserId, assessmentId])
  @@map("assessment_attempts")
}

model Certificate {
  id                String   @id @default(uuid())
  studentUserId     String
  courseId          String
  certificateNumber String   @unique
  issuedAt          DateTime @default(now())

  studentUser User   @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentUserId, courseId])
  @@map("certificates")
}

// A student applies for the discounted program. An administrator approves or rejects it;
// only an APPROVED application unlocks the scholarship price for that course.
model ScholarshipApplication {
  id                   String                       @id @default(uuid())
  applicantUserId      String
  courseId             String
  phoneNumber          String
  currentOccupation    String
  motivationStatement  String
  applicationStatus    ScholarshipApplicationStatus @default(PENDING)
  reviewerNote         String?
  reviewedByUserId     String?
  reviewedAt           DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  applicantUser User   @relation(fields: [applicantUserId], references: [id], onDelete: Cascade)
  course        Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([applicantUserId, courseId])
  @@index([applicationStatus])
  @@map("scholarship_applications")
}

// One row per "forgot password" request. Only a SHA-256 hash of the token is stored, so a database leak
// cannot be used to reset anyone's password. A token works once and expires after 1 hour.
model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String
  hashedToken String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// One review per student per course (a student can edit theirs). Only enrolled students may review.
model CourseReview {
  id              String   @id @default(uuid())
  courseId        String
  studentUserId   String
  ratingOutOfFive Int
  reviewText      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentUser User   @relation(fields: [studentUserId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentUserId])
  @@index([courseId])
  @@map("course_reviews")
}

// A downloadable file attached to a lesson (slides, PDF notes, source code...). Stored privately in the course owner's Cloudinary.
model LessonResource {
  id                 String   @id @default(uuid())
  lessonId           String
  displayName        String
  originalFileName   String
  cloudinaryPublicId String
  fileSizeInBytes    Int
  createdAt          DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("lesson_resources")
}

// Questions are visible to the students of the course; instructors answer them.
model LessonQuestion {
  id            String   @id @default(uuid())
  lessonId      String
  askedByUserId String
  questionText  String
  createdAt     DateTime @default(now())

  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  askedByUser User           @relation(fields: [askedByUserId], references: [id], onDelete: Cascade)
  answers     LessonAnswer[]

  @@index([lessonId, createdAt])
  @@map("lesson_questions")
}

model LessonAnswer {
  id               String   @id @default(uuid())
  questionId       String
  answeredByUserId String
  answerText       String
  createdAt        DateTime @default(now())

  question        LessonQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answeredByUser  User           @relation(fields: [answeredByUserId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("lesson_answers")
}
